# Environment Configuration Template
SECRET_KEY=super-secret-key-change-this-in-production
DATABASE_URL=sqlite:///database/startup_platform.db

# AI Engine Services Keys (Optional - Heuristic LLM mode active if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NEWS_API_KEY=

# Advanced local embedding model. Keep 0 for fast demos; set 1 to use Sentence Transformers.
ENABLE_SENTENCE_TRANSFORMERS=0

# Optional PyTrends tuning. Add comma-separated HTTPS proxies only if Google rate-limits you.
PYTRENDS_LANGUAGE=en-US
PYTRENDS_TIMEZONE=330
PYTRENDS_CONNECT_TIMEOUT=5
PYTRENDS_READ_TIMEOUT=10
PYTRENDS_RETRIES=2
PYTRENDS_BACKOFF_FACTOR=0.1
PYTRENDS_PROXIES=

# Test/safety switch. Keep 0 during normal app usage.
DISABLE_LIVE_AI=0

FLASK_ENV=development
PORT=5000
